# The development stack (docker/compose.dev.yml) reads this file as `.env`, which is
# gitignored; `scripts/dev.sh` copies it the first time you bring the stack up.
ASTRO_TELEMETRY_DISABLED=1

# The deployed origin and base path, for canonical links and the sitemap. Unset, the site
# builds for https://dev.manablox.io at `/`.
# DOCS_SITE_URL=https://dev.manablox.io
# DOCS_BASE_PATH=/
